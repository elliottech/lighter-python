# Conservative Trading Configuration
# Recommended for beginners or small accounts

# =============================================================================
# LIGHTER API CREDENTIALS (REPLACE WITH YOUR VALUES)
# =============================================================================
LIGHTER_API_KEY_PRIVATE_KEY=your_private_key_here
LIGHTER_ACCOUNT_INDEX=your_account_index_here
LIGHTER_API_KEY_INDEX=your_api_key_index_here

# =============================================================================
# CONSERVATIVE TRADING SETTINGS
# =============================================================================
ACCOUNT_BALANCE=500
MIN_POSITION_PERCENT=10    # Risk only 10% per trade
MAX_POSITION_PERCENT=20    # Maximum 20% risk
MIN_TRADE_INTERVAL=60      # Wait at least 1 minute between trades
MAX_TRADE_INTERVAL=600     # Wait up to 10 minutes
MAX_DAILY_TRADES=20        # Limit to 20 trades per day

# =============================================================================
# CONSERVATIVE LEVERAGE (Lower risk)
# =============================================================================
LEVERAGE_BTC=2
LEVERAGE_ETH=2
LEVERAGE_HYPE=3
LEVERAGE_SOL=3
LEVERAGE_BNB=2
MARGIN_MODE=0

# =============================================================================
# CONSERVATIVE POSITION MANAGEMENT
# =============================================================================
# Longer, more stable hold times for conservative trading
MIN_POSITION_HOLD_MINUTES=10    # Minimum 10 minutes
MAX_POSITION_HOLD_MINUTES=30    # Maximum 30 minutes

# Legacy setting (use 0 for dynamic system)
POSITION_HOLD_MINUTES=0

SINGLE_POSITION_MODE=true

# =============================================================================
# MANDATORY PROXY SETTINGS
# =============================================================================
# Proxy is REQUIRED for this bot
USE_PROXY=true
PROXY_URL=http://username:password@proxy.example.com:8080

# =============================================================================
# BASIC SETTINGS
# =============================================================================
LOG_LEVEL=INFO
ALLOWED_TRADING_PAIRS=BTC,ETH,SOL
