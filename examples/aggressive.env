# Aggressive Trading Configuration
# For experienced traders with larger accounts

# =============================================================================
# LIGHTER API CREDENTIALS (REPLACE WITH YOUR VALUES)
# =============================================================================
LIGHTER_API_KEY_PRIVATE_KEY=your_private_key_here
LIGHTER_ACCOUNT_INDEX=your_account_index_here
LIGHTER_API_KEY_INDEX=your_api_key_index_here

# =============================================================================
# AGGRESSIVE TRADING SETTINGS
# =============================================================================
ACCOUNT_BALANCE=2000
MIN_POSITION_PERCENT=50    # Risk 50% per trade
MAX_POSITION_PERCENT=80    # Maximum 80% risk
MIN_TRADE_INTERVAL=30      # Quick trades
MAX_TRADE_INTERVAL=180     # 3 minutes max wait
MAX_DAILY_TRADES=100       # More trades per day

# =============================================================================
# HIGH LEVERAGE (Higher risk/reward)
# =============================================================================
LEVERAGE_BTC=10
LEVERAGE_ETH=8
LEVERAGE_HYPE=15
LEVERAGE_SOL=12
LEVERAGE_BNB=8
MARGIN_MODE=0

# =============================================================================
# AGGRESSIVE POSITION MANAGEMENT
# =============================================================================
# Quick scalping with dynamic hold times
MIN_POSITION_HOLD_MINUTES=1     # Very short minimum (1 minute)
MAX_POSITION_HOLD_MINUTES=5     # Quick maximum (5 minutes)

# Legacy setting (use 0 for dynamic system)
POSITION_HOLD_MINUTES=0

SINGLE_POSITION_MODE=true

# =============================================================================
# MANDATORY PROXY SETTINGS
# =============================================================================
# Proxy is REQUIRED for this bot
USE_PROXY=true
PROXY_URL=http://username:password@proxy.example.com:8080

# =============================================================================
# FULL PAIR TRADING
# =============================================================================
LOG_LEVEL=INFO
ALLOWED_TRADING_PAIRS=BTC,ETH,HYPE,SOL,BNB
